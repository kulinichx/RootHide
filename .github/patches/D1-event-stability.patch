+- (int)spawnJbctlAsRootWithArgs:(NSArray<NSString *> *)args
+{
+    // This deliberately keeps RootHide's existing runAsRoot/runUnsandboxed
+    // implementation.  Only the child sequencing is forward-ported.
+    size_t argc = args.count + 4;
+    char **argBuf = calloc(argc, sizeof(char *));
+    if (!argBuf) return ENOMEM;
+
+    int i = 0;
+    argBuf[i++] = strdup(JBROOT_PATH("/basebin/jbctl"));
+    for (NSString *arg in args) argBuf[i++] = strdup(arg.UTF8String);
+    argBuf[i++] = strdup("--waitfor");
+    argBuf[i++] = strdup("3");
+    argBuf[i] = NULL;
+
+    int waitPipe[2] = {-1, -1};
+    int r = pipe(waitPipe);
+    if (r != 0) {
+        for (int n = 0; n < i; n++) free(argBuf[n]);
+        free(argBuf);
+        return r;
+    }
+
+    posix_spawn_file_actions_t actions;
+    posix_spawn_file_actions_init(&actions);
+    posix_spawn_file_actions_adddup2(&actions, waitPipe[0], 3);
+
+    __block pid_t pid = -1;
+    __block int spawnResult = -1;
+    [self runAsRoot:^{
+        [self runUnsandboxed:^{
+            spawnResult = posix_spawn(&pid, argBuf[0], &actions, NULL, argBuf, environ);
+        }];
+        // runUnsandboxed has restored the original MAC label here, and
+        // runAsRoot will restore the application's temporary credentials
+        // before control returns to the child below.
+    }];
+
+    posix_spawn_file_actions_destroy(&actions);
+
+    if (spawnResult == 0) {
+        char token = 'w';
+        (void)write(waitPipe[1], &token, sizeof(token));
+    }
+    close(waitPipe[0]);
+    close(waitPipe[1]);
+    waitPipe[0] = waitPipe[1] = -1;
+
+    if (spawnResult != 0) { r = spawnResult; goto out; }
+    r = cmd_wait_for_exit(pid);
+
+out:
+    if (waitPipe[0] >= 0) close(waitPipe[0]);
+    if (waitPipe[1] >= 0) close(waitPipe[1]);
+    for (int n = 0; n < i; n++) free(argBuf[n]);
+    free(argBuf);
+    return r;
+}
