+                                                       uint8_t hashSize,
+                                                       uint32_t specialSlotCount,
+                                                       uint32_t codeSlotCount,
+                                                       uint8_t pageSize);
+
+roothide_team_id_state_t roothide_signature_team_id_state(uint32_t codeDirectoryVersion,
